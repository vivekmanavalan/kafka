<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mycompany.kafka</groupId>
    <artifactId>order-schemas</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <avro.version>1.12.1</avro.version>
        <confluent.version>8.1.1</confluent.version>

        <!-- Placeholders, overridden per profile via -D from CI/CD -->
        <schema.registry.url>http://localhost:8081</schema.registry.url>
        <schema.registry.api.key>placeholder</schema.registry.api.key>
        <schema.registry.api.secret>placeholder</schema.registry.api.secret>
    </properties>

    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Step 1: Generate Java classes from .avsc files -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <id>generate-avro-classes</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <stringType>String</stringType>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Step 2: Compatibility check + registration against schema registry -->
            <plugin>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-schema-registry-maven-plugin</artifactId>
                <version>${confluent.version}</version>
                <configuration>
                    <schemaRegistryUrls>
                        <param>${schema.registry.url}</param>
                    </schemaRegistryUrls>
                    <userInfoConfig>${schema.registry.api.key}:${schema.registry.api.secret}</userInfoConfig>
                    <schemaTypes>
                        <order-events-value>AVRO</order-events-value>
                        <payment-events-value>AVRO</payment-events-value>
                    </schemaTypes>
                    <subjects>
                        <order-events-value>src/main/avro/order_event.avsc</order-events-value>
                        <payment-events-value>src/main/avro/payment_event.avsc</payment-events-value>
                    </subjects>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <schema.registry.url>${env.SCHEMA_REGISTRY_URL_DEV}</schema.registry.url>
                <schema.registry.api.key>${env.SCHEMA_REGISTRY_API_KEY_DEV}</schema.registry.api.key>
                <schema.registry.api.secret>${env.SCHEMA_REGISTRY_API_SECRET_DEV}</schema.registry.api.secret>
            </properties>
        </profile>
        <profile>
            <id>int</id>
            <properties>
                <schema.registry.url>${env.SCHEMA_REGISTRY_URL_INT}</schema.registry.url>
                <schema.registry.api.key>${env.SCHEMA_REGISTRY_API_KEY_INT}</schema.registry.api.key>
                <schema.registry.api.secret>${env.SCHEMA_REGISTRY_API_SECRET_INT}</schema.registry.api.secret>
            </properties>
        </profile>
        <profile>
            <id>pre</id>
            <properties>
                <schema.registry.url>${env.SCHEMA_REGISTRY_URL_PRE}</schema.registry.url>
                <schema.registry.api.key>${env.SCHEMA_REGISTRY_API_KEY_PRE}</schema.registry.api.key>
                <schema.registry.api.secret>${env.SCHEMA_REGISTRY_API_SECRET_PRE}</schema.registry.api.secret>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <schema.registry.url>${env.SCHEMA_REGISTRY_URL_PROD}</schema.registry.url>
                <schema.registry.api.key>${env.SCHEMA_REGISTRY_API_KEY_PROD}</schema.registry.api.key>
                <schema.registry.api.secret>${env.SCHEMA_REGISTRY_API_SECRET_PROD}</schema.registry.api.secret>
            </properties>
        </profile>
    </profiles>
</project>